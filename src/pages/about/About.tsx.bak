              <img 
                src={sakthiBalasundaram} 
                alt="Dr. S. Sakthi Balasundaram, Secretary" 
                className="w-full h-auto object-contain block"
              />
            </div>
            
            <div className="relative z-10 w-full rounded-2xl overflow-hidden border-4 border-amber-400 shadow-xl bg-white transition-transform hover:-translate-y-2">
              <img 
                src={msTholkappian} 
                alt="CA M.S. Tholkappian, Trustee" 
                className="w-full h-auto object-contain block"
              />
            </div>
          </div>
        </div>
      </section>

    </div>
  );
};
